<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#00796B">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Weekend Journey Test"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="18-Step Home → Park → Restaurant → Home → Night Market → Home"
            android:textColor="#B2DFDB"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingTop="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔬  Uses novel distances to prove model generalization"
            android:textColor="#E0F2F1"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="4dp"/>

    </LinearLayout>

    <!-- Run Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRun2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="▶  Run Weekend Journey"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:backgroundTint="#00796B"
        app:cornerRadius="8dp"/>

    <!-- Progress indicator -->
    <LinearLayout
        android:id="@+id/progressContainer2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="18"
            android:progressTint="#00796B"/>

        <TextView
            android:id="@+id/tvProgress2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:textSize="13sp"
            android:textColor="#666666"
            android:text="0 / 18"/>

    </LinearLayout>

    <!-- Scrollable output -->
    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvOut2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textColor="#333333"
            android:lineSpacingExtra="3dp"
            android:text="Tap the button above to run the weekend journey.\nThis uses completely different distances from the 29-step test\nto prove the model generalizes."/>

    </ScrollView>

</LinearLayout>
